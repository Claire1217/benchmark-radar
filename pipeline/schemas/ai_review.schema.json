{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "relation",
          "artifact_role",
          "benchmark_name",
          "evidence_quote",
          "confidence",
          "reason",
          "signals"
        ],
        "properties": {
          "id": {"type": "string"},
          "verdict": {
            "type": "string",
            "enum": ["benchmark_release", "uses_existing_benchmark", "unclear"]
          },
          "relation": {
            "type": "string",
            "enum": ["introduces", "extends", "aggregates", "evaluates_only", "unclear"]
          },
          "artifact_role": {
            "type": "string",
            "enum": [
              "reusable_benchmark",
              "diagnostic_benchmark",
              "benchmarking_study",
              "uses_existing_benchmarks",
              "unclear"
            ]
          },
          "benchmark_name": {"type": "string"},
          "evidence_quote": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"},
          "signals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "third_party_runnable",
              "stable_task_metric_protocol",
              "public_artifacts",
              "intended_use"
            ],
            "properties": {
              "third_party_runnable": {"type": ["boolean", "null"]},
              "stable_task_metric_protocol": {"type": ["boolean", "null"]},
              "public_artifacts": {"type": ["boolean", "null"]},
              "intended_use": {
                "type": "string",
                "enum": ["third_party_comparison", "claim_support", "unclear"]
              }
            }
          }
        }
      }
    }
  }
}
